# Sample environment file. Copy to .env and fill in your values:
#   cp .env.example .env
# .env is git-ignored; this file (.env.example) is safe to commit.

# Anthropic API key (https://console.anthropic.com) — used by the Claude baseline
# (src/claude/run_claude.py), which runs the same tools/prompts through Claude Sonnet.
ANTHROPIC_API_KEY=

# --- Web tools (src/backends.py) -------------------------------------------------
# web_search is backed by Brave; scrape_url runs a LOCAL headless Chromium (no key,
# needs `playwright install chromium`). Set the Brave key for the live path; pass
# --offline to skip it and use the local stub instead.

# Brave Search (https://brave.com/search/api) — backs web_search.
BRAVE_API_KEY=

# --- Corpus store + optional sourcing enrichment (notes/v2_rebuild_plan.md) ------
# S3 is the source of truth for the corpus + cache; `data/` is synced, not
# committed (scripts/infra/corpus_sync.py). The devbox authenticates via its EC2
# instance profile (menu-corpus-devbox-role, see S3_setup.md) — do NOT put
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY here on the devbox; static keys are
# only for running this code somewhere without the instance profile.
S3_BUCKET=restaurant-menu-corpus
S3_PREFIX=v2
# Bucket region (pin it so boto3 doesn't default to us-east-1 and redirect).
AWS_DEFAULT_REGION=us-west-2

# Google Places (New) API key — OPTIONAL. Only used by --enrich-places in
# scripts/corpus/harvest.py for chain signal. Requires a GCP project with billing
# enabled + a restricted key. OSM/Overpass needs no key.
GOOGLE_PLACES_API_KEY=


HF_TOKEN=
